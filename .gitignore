# .gitignore (Hardened)

# Secret/Sensitive Config
.env
.env.local
.env.*.local
*.pem
*.key
firebase-applet-config.json

# AI Studio Tooling Artifacts
/.aistudio/
/.emergent/
/memory/
/plan/
/scratch/
test_result.md
test_reports/

# OS/Editor junk
.DS_Store
.vscode/
.idea/

# Dependencies & Build
node_modules/
dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
