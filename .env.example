# GEMINI_API_KEY: Required for the server-side Gemini AI calls (J.A.R.V.I.S. + macro intelligence).
# Keep this secret and server-side only. Configure via the Secrets panel; never commit a real value.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OWNER_ACCESS_TOKEN: Single-operator access gate for the AI endpoints and Owner/Admin desk.
# Use a long random string. If unset, the AI endpoints are DISABLED (fail-closed). Keep secret.
OWNER_ACCESS_TOKEN="CHANGE_ME_LONG_RANDOM_SECRET"

# APP_URL: Public URL for the iOS web-clip (.mobileconfig) profile. Optional — falls back to the request host.
APP_URL="MY_APP_URL"
