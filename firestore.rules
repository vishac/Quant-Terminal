rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Auth & Role Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin privileges derive strictly from verified custom claims or verified owner email.
    // Untrusted document fields (e.g. users/{uid}.role) are NEVER used for privilege evaluation.
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && request.auth.token.role == 'admin') ||
        (request.auth.token.email == 'reachvishalc@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isRiskOfficer() {
      return isSignedIn() && (
        isAdmin() ||
        (request.auth.token != null && request.auth.token.role == 'risk_officer')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    // Collection: /users/{userId}
    // Users can only read their own record (or admin can read all).
    // Users cannot promote themselves or mutate their assigned role.
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && (
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role in ['quant_trader', 'analyst'])) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Collection: /trader_states/{userId}
    match /trader_states/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isRiskOfficer());
      allow create: if isSignedIn() && (isOwner(userId) || isRiskOfficer());
      allow update: if isSignedIn() && (isOwner(userId) || isRiskOfficer());
      allow delete: if isAdmin();
    }

    // Collection: /orders/{orderId}
    // Users can only read their own orders; admin can inspect all.
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isRiskOfficer();
      allow delete: if isAdmin();
    }

    // Collection: /desk_config/{configId}
    match /desk_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isRiskOfficer();
    }

    // Collection: /backtests/{backtestId}
    // Users can only read their own backtest records; admin can read all.
    match /backtests/{backtestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
